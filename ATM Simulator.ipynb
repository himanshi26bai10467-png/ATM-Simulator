# ATM SIMULATOR

balance = 10000
transactions = []


# LANGUAGE SELECTION
def select_language():
    print("\n========== LANGUAGE ==========")
    print("1. English")
    print("2. Hindi")

    choice = input("Select language / Bhasha chune: ")

    if choice == "1":
        return "English"
    elif choice == "2":
        return "Hindi"
    else:
        print("Invalid choice! English selected by default.")
        return "English"

